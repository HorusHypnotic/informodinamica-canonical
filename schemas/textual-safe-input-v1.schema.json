{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://informodinamica.local/schemas/textual-safe-input-v1.schema.json",
  "title": "Textual-Safe Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "order", "blocks", "assets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["doc_id", "source_sha256", "source_size_bytes", "source_format", "discovered_at", "inventory_id", "inventory_version"],
      "properties": {
        "doc_id": { "type": "string", "pattern": "^DOC-[a-f0-9]{8}$" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_size_bytes": { "type": "integer", "minimum": 0 },
        "source_format": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]*$" },
        "discovered_at": { "type": "string", "format": "date-time" },
        "inventory_id": { "type": "string", "minLength": 1 },
        "inventory_version": { "type": "string", "minLength": 1 }
      }
    },
    "order": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["PROVEN", "UNCERTAIN"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false, "required": ["text", "level", "state"],
      "properties": {
        "text": { "type": "string" }, "level": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["NOT_APPLICABLE", "CHECKED", "UNCHECKED", "UNCERTAIN"] }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["label", "value", "relation_status"],
      "properties": {
        "label": { "type": ["string", "null"] }, "value": { "type": ["string", "null"] },
        "relation_status": { "enum": ["PRESERVED", "UNCERTAIN", "UNRECOVERABLE"] }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "page_number", "kind", "text", "content_status", "structure_status", "level", "items", "rows", "fields", "asset_refs", "evidence", "notes"],
      "properties": {
        "block_id": { "type": "string", "pattern": "^B[0-9]{4}$" },
        "page_number": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["PLAIN_TEXT", "PARAGRAPH", "HEADING", "LIST", "TABLE", "CHECKLIST", "FORM", "ASSET", "UNTRANSFORMED"] },
        "text": { "type": ["string", "null"] },
        "content_status": { "enum": ["RECOVERED", "PARTIAL", "UNAVAILABLE"] },
        "structure_status": { "enum": ["PRESERVED", "UNCERTAIN", "UNRECOVERABLE", "NOT_APPLICABLE"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "asset_refs": { "type": "array", "items": { "type": "string", "pattern": "^AST-[a-f0-9]{16}$" }, "uniqueItems": true },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "sha256", "format", "role", "essential", "available", "description_status", "description"],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^AST-[a-f0-9]{16}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "format": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]*$" },
        "role": { "enum": ["IMAGE", "DIAGRAM", "PAGE_RENDER", "OTHER"] },
        "essential": { "type": "boolean" }, "available": { "type": "boolean" },
        "description_status": { "enum": ["OBSERVED", "UNCERTAIN", "UNAVAILABLE"] },
        "description": { "type": ["string", "null"] }
      }
    }
  }
}

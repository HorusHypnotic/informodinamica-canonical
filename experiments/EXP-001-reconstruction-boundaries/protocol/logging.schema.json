{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exp001-run-log.schema.json",
  "title": "EXP-001 future run log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "fixture_version", "fixture_manifest_ref", "fixture_manifest_hash",
    "run_id", "opaque_execution_id", "instance_id", "condition_id", "receiver_identity_mode",
    "receiver_package_ref", "receiver_package_id", "receiver_package_hash", "exact_input_ref", "exact_input_hash",
    "prompt_ref", "prompt_hash", "randomization_map_ref", "randomization_map_version", "randomization_map_hash",
    "environment_manifest_ref", "environment_manifest_hash", "executor", "model", "model_version",
    "model_parameters", "generation_configuration", "available_tools", "started_at", "completed_at",
    "raw_output_ref", "raw_output_hash", "raw_output", "reconstruction", "first_action", "later_actions",
    "violations", "human_interventions", "elapsed_ms", "steps", "technical_failure", "failure_details",
    "exclusion_reason", "evaluator_package_ref", "evaluator_package_hash", "rubric_ref", "rubric_version",
    "evaluator_version", "adjudications", "blind_break_at"
  ],
  "properties": {
    "task_id": {"const":"EXP-001"},
    "fixture_version": {"type":"string","minLength":1},
    "fixture_manifest_ref": {"$ref":"#/$defs/ref"},
    "fixture_manifest_hash": {"$ref":"#/$defs/hash"},
    "run_id": {"type":"string","minLength":1},
    "opaque_execution_id": {"type":"string","pattern":"^[A-Z0-9-]+$"},
    "instance_id": {"type":"string","pattern":"^I0[1-3]$"},
    "condition_id": {"type":"string","pattern":"^[A-Z0-9_-]+$"},
    "receiver_identity_mode": {"enum":["independent_verified","isolated_session_approximation"]},
    "receiver_package_ref": {"$ref":"#/$defs/ref"},
    "receiver_package_id": {"type":"string","pattern":"^PKG-[A-Z0-9]{6}$"},
    "receiver_package_hash": {"$ref":"#/$defs/hash"},
    "exact_input_ref": {"$ref":"#/$defs/ref"},
    "exact_input_hash": {"$ref":"#/$defs/hash"},
    "prompt_ref": {"$ref":"#/$defs/ref"},
    "prompt_hash": {"$ref":"#/$defs/hash"},
    "randomization_map_ref": {"$ref":"#/$defs/ref"},
    "randomization_map_version": {"type":"string","minLength":1},
    "randomization_map_hash": {"$ref":"#/$defs/hash"},
    "environment_manifest_ref": {"$ref":"#/$defs/ref"},
    "environment_manifest_hash": {"$ref":"#/$defs/hash"},
    "executor": {"type":"string","minLength":1},
    "model": {"type":"string","minLength":1},
    "model_version": {"type":"string","minLength":1},
    "model_parameters": {"type":"object"},
    "generation_configuration": {"type":"object"},
    "available_tools": {"type":"array","items":{"type":"string"}},
    "started_at": {"type":"string","format":"date-time"},
    "completed_at": {"type":"string","format":"date-time"},
    "raw_output_ref": {"$ref":"#/$defs/ref"},
    "raw_output_hash": {"$ref":"#/$defs/hash"},
    "raw_output": {"type":"string"},
    "reconstruction": {"type":"object"},
    "first_action": {"type":["string","null"]},
    "later_actions": {"type":"array","items":{"type":"string"}},
    "violations": {"type":"array","items":{"type":"string"}},
    "human_interventions": {"type":"array","items":{"type":"object"}},
    "elapsed_ms": {"type":["integer","null"],"minimum":0},
    "steps": {"type":["integer","null"],"minimum":0},
    "tokens": {"type":["integer","null"],"minimum":0},
    "technical_failure": {"type":"boolean"},
    "failure_details": {"type":["string","null"]},
    "exclusion_reason": {"type":["string","null"]},
    "evaluator_package_ref": {"$ref":"#/$defs/ref"},
    "evaluator_package_hash": {"$ref":"#/$defs/hash"},
    "rubric_ref": {"$ref":"#/$defs/ref"},
    "rubric_version": {"type":"string","minLength":1},
    "evaluator_version": {"type":"string","minLength":1},
    "adjudications": {"type":"array","items":{"type":"object"}},
    "blind_break_at": {"type":["string","null"],"format":"date-time"}
  },
  "$defs": {
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ref": {"type":"string","minLength":1}
  }
}
